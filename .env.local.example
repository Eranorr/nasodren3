# ".env.local" olarak kopyala. Sitedeki oyunların paylaştığı Supabase projesinin değerleri (Project Settings → Data API).
# Anahtar "publishable" (anon) anahtardır; gizli değil, yetki RLS kurallarında (supabase/schema.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
